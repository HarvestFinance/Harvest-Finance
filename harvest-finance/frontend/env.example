# API Configuration
# When using the built-in Next.js API routes (mock/fallback), leave this empty.
# Set this to your backend API URL (e.g., http://localhost:5000/api/v1) only
# if you have an external backend service.
NEXT_PUBLIC_API_URL=

# Stellar Configuration
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
